
# UB sources
```Installazione-e-aggiornamento-liste-UB
DEST="$PWD"
errori=0

while IFS='|' read -r nome url; do
    file="$DEST/$nome"
    tmp="$(mktemp "$DEST/.download.XXXXXX")" || { errori=1; continue; }

    if curl -fLsS --retry 3 --connect-timeout 20 --max-time 180 --compressed \
        -o "$tmp" "$url" && [[ -s "$tmp" ]]; then
        mv -f -- "$tmp" "$file"
        echo "OK: $nome"
    else
        rm -f -- "$tmp"
        echo "ERRORE: $nome" >&2
        errori=1
    fi
